{
  "name": "@lexical/accessibility",
  "description": "Accessibility plugin for Lexical - Screen reader announcements for editor operations.",
  "keywords": [
    "lexical",
    "accessibility",
    "a11y",
    "screen-reader",
    "aria",
    "wcag",
    "nvda",
    "jaws",
    "voiceover"
  ],
  "license": "MIT",
  "version": "0.38.2",
  "main": "./dist/LexicalAccessibility.js",
  "types": "./dist/typescript-too-old.d.ts",
  "dependencies": {
    "@lexical/code": "workspace:*",
    "@lexical/link": "workspace:*",
    "@lexical/list": "workspace:*",
    "@lexical/markdown": "workspace:*",
    "@lexical/react": "workspace:*",
    "@lexical/rich-text": "workspace:*",
    "lexical": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facebook/lexical.git",
    "directory": "packages/lexical-accessibility"
  },
  "module": "./dist/LexicalAccessibility.mjs",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types@<5.2": "./dist/typescript-too-old.d.ts",
        "types": "./dist/index.d.ts",
        "development": "./dist/LexicalAccessibility.dev.mjs",
        "production": "./dist/LexicalAccessibility.prod.mjs",
        "node": "./dist/LexicalAccessibility.node.mjs",
        "default": "./dist/LexicalAccessibility.mjs"
      },
      "require": {
        "types@<5.2": "./dist/typescript-too-old.d.ts",
        "types": "./dist/index.d.ts",
        "development": "./dist/LexicalAccessibility.dev.js",
        "production": "./dist/LexicalAccessibility.prod.js",
        "default": "./dist/LexicalAccessibility.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "!src/__bench__",
    "!src/__mocks__",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.bench.ts",
    "!src/**/*.bench.tsx",
    "README.md",
    "LICENSE"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "./dist/typescript-too-old.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "typescript": ">=5.2"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
